# ─────────────────────────────────────────────────────────────────────────────
# Knowledge Graph AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenRouter (Primary AI Provider) ─────────────────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter API base URL (do not change unless using a custom proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The model to use.
# Use 'openrouter/auto' to let OpenRouter pick the best available model (recommended).
# Or pick a specific free model. Check availability at: https://openrouter.ai/models?q=:free
# Currently available free models (as of Aug 2026):
#   google/gemma-4-31b-it:free
#   google/gemma-4-26b-a4b-it:free
#   liquid/lfm-2.5-2.6b:free
#   poolside/laguna-s-2.1:free
#   nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=openrouter/auto

# Optional: OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=https://knowledge-graph-ai.local
OPENROUTER_APP_TITLE=Knowledge Graph AI

# ── Legacy / Fallback ─────────────────────────────────────────────────────────
# Only needed if you use Gemini via the Settings UI
GEMINI_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
# Port the server listens on (default: 3000)
PORT=3000
